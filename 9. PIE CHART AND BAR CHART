fruits <- c("Apple", "Banana", "Mango", "Orange")
sales <- c(30, 15, 25, 20)

par(mfrow = c(1, 2))

pie(
  sales,
  labels = fruits,
  main = "Fruit Sales - Pie Chart",
  col = rainbow(length(fruits))
)

barplot(
  sales,
  names.arg = fruits,
  main = "Fruit Sales - Bar Chart",
  xlab = "Fruits",
  ylab = "Sales",
  col = "skyblue",
  border = "black"
)
